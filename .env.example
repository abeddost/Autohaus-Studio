# ---------------------------------------------------------------------------
# Autohaus Webstudio – environment variables
# Copy to .env.local for development. Never commit real values.
# Only NEXT_PUBLIC_* values are exposed to the browser.
# ---------------------------------------------------------------------------

# Canonical public URL (used for canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://www.autohaus-webstudio.de

# Search engine indexing. Keep "false" until launch (robots.txt disallows all).
SITE_INDEXING=false

# Show "Fehlt:" markers for missing content on preview deployments (never in production).
NEXT_PUBLIC_SHOW_MISSING=false

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, RDS, self-hosted …).
# Without it, development uses an embedded PGlite database in .data/pglite.
# Production without DATABASE_URL answers enquiries with 503 (nothing is faked).
DATABASE_URL=
# Run migrations automatically on first connection (otherwise: pnpm db:migrate)
DB_AUTO_MIGRATE=false
# Optional: embedded database directory, or "memory://" (tests)
# PGLITE_DIR=.data/pglite

# --- Transactional email ----------------------------------------------------
# resend | postmark | none
EMAIL_PROVIDER=none
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
# Sender on a domain verified with the provider
EMAIL_FROM="Autohaus Webstudio <anfragen@autohaus-webstudio.de>"
# One or more recipients, comma-separated
CONTACT_RECIPIENT=

# --- Security ---------------------------------------------------------------
# Signs the enquiry form timestamp (min. 16 characters, e.g. `openssl rand -hex 32`)
FORM_SECRET=
# Salt for hashing IP addresses in the rate limiter
RATE_LIMIT_SALT=
# Protects GET /api/cron/notifications (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# --- Launch -----------------------------------------------------------------
# Set to 1 in production builds to fail while launch blockers remain.
LAUNCH_STRICT=0
